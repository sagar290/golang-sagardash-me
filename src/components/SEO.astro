---
import content from "../data/content.json";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    canonicalURL?: string | URL;
    type?: string;
}

const siteUrl = Astro.site ?? new URL(content.site_url);
const baseUrl = import.meta.env.BASE_URL;
const publicAsset = (path: string) =>
    `${baseUrl.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;
const defaultCanonicalURL = new URL(baseUrl, siteUrl);

const {
    title = `${content.name} | ${content.title}`,
    description = content.description,
    image = "/og-image.png",
    canonicalURL = defaultCanonicalURL,
    type = "website",
} = Astro.props;

const imageUrl = new URL(publicAsset(image), siteUrl);
const canonicalURLString = canonicalURL.toString();
const imageUrlString = imageUrl.toString();
const sameAs = [
    content.socials.github,
    content.socials.linkedin,
    content.socials.blog,
].filter(Boolean);
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Person",
            "@id": `${canonicalURLString}#person`,
            name: content.name,
            jobTitle: content.title,
            url: canonicalURLString,
            email: `mailto:${content.email}`,
            image: imageUrlString,
            description,
            sameAs,
            address: {
                "@type": "PostalAddress",
                addressLocality: content.position.city,
                addressCountry: content.position.country,
            },
            knowsAbout: [
                "Go",
                "Microservices",
                "Kubernetes",
                "Distributed Systems",
                "Cloud Architecture",
                "API Platforms",
            ],
        },
        {
            "@type": "ProfilePage",
            "@id": `${canonicalURLString}#profile-page`,
            url: canonicalURLString,
            name: title,
            description,
            image: imageUrlString,
            mainEntity: {
                "@id": `${canonicalURLString}#person`,
            },
        },
    ],
};
---

<!-- Basic SEO -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURLString} />
<meta name="robots" content="index, follow" />

<!-- Open Graph / FB -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURLString} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrlString} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:site_name" content={`${content.name} Portfolio`} />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURLString} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrlString} />

<!-- PWA / Mobile tags -->
<meta name="apple-mobile-web-app-title" content={`${content.name} Portfolio`} />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
