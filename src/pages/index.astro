---
import Layout from "../layouts/Layout.astro";
import CodeBlock from "../components/CodeBlock.astro";
import ContactForm from "../components/ContactForm.astro";
import avatarUrl from "../assets/avatar.png?url";
import content from "../data/content.json";
import { getMediumArticles } from "../../fetch-articles.js";

// Utility for indentation and common styles
const comment = "text-editor-comment italic";
const string = "text-editor-string";
const keyword = "text-editor-keyword";
const variable = "text-editor-variable";
const number = "text-editor-number";
const func = "text-editor-func";

// Fetch articles from Medium at build time
const articles = await getMediumArticles();
---

<Layout title={`${content.name} | ${content.title}`}>
    <main
        class="portfolio-canvas min-h-screen grid grid-cols-[450px_1fr] bg-[#1e1e1e] p-10 gap-8 w-[1280px] mx-auto"
    >
        <h1 class="sr-only">{content.name} - {content.title}</h1>
        <!-- Left Sidebar -->
        <aside class="flex flex-col gap-10">
            <!-- Pfp block -->
            <div class="code-container">
                <div class={comment}>{`<img />`}</div>
                <div
                    class="relative my-4 border-2 border-editor-keyword/30 p-1 w-fit bg-[#252526] shadow-xl"
                >
                    <img
                        src={avatarUrl}
                        alt={content.name}
                        class="w-64 aspect-square object-cover"
                    />
                </div>
                <div class={comment}>{`</img>`}</div>
            </div>

            <!-- Sidebar Blocks -->
            <div class="flex flex-col gap-6">
                <CodeBlock keyword="var" varTitle="platforms" title="[]string" isStruct={false}>
                    <ul class="list-none flex flex-col gap-1">
                        {content.platforms.map((p) => <li>"{p}",</li>)}
                    </ul>
                </CodeBlock>

                <CodeBlock keyword="var" title="[]String" varTitle="languages" isStruct={false}>
                    <ul class="list-none flex flex-col gap-1">
                        <li>
                            {`"${content.languages.join('", "')}"`}
                        </li>
                    </ul>
                </CodeBlock>

                <CodeBlock keyword="var" varTitle="softwares" title="[]string" isStruct={false}>
                    <div class="grid grid-cols-1 gap-1">
                        {content.softwares.map((s) => <span>{s},</span>)}
                    </div>
                </CodeBlock>

                <CodeBlock keyword="var" title="Links" varTitle="socials" isStruct={false}>
                    <ul class="list-none flex flex-col gap-2">
                        <li class="flex items-center gap-2">
                            <span class={variable}>Website</span>
                            <span class="text-editor-text">:</span>
                            <a
                                href={content.socials.website}
                                target="_blank"
                                rel="noopener noreferrer"
                                class={`${string} hover:underline decoration-editor-string/40 underline-offset-4`}
                                >"{content.socials.website}"</a
                            >,
                        </li>
                        <li class="flex items-center gap-2">
                            <span class={variable}>Blog</span>
                            <span class="text-editor-text">:</span>
                            <a
                                href={content.socials.blog}
                                target="_blank"
                                rel="noopener noreferrer"
                                class={`${string} hover:underline decoration-editor-string/40 underline-offset-4`}
                                >"{content.socials.blog}"</a
                            >,
                        </li>
                        <li class="flex items-center gap-2">
                            <span class={variable}>LinkedIn</span>
                            <span class="text-editor-text">:</span>
                            <a
                                href={content.socials.linkedin}
                                target="_blank"
                                rel="noopener noreferrer"
                                class={`${string} hover:underline decoration-editor-string/40 underline-offset-4`}
                                >"{content.socials.linkedin}"</a
                            >,
                        </li>
                        <li class="flex items-center gap-2">
                            <span class={variable}>GitHub</span>
                            <span class="text-editor-text">:</span>
                            <a
                                href={content.socials.github}
                                target="_blank"
                                rel="noopener noreferrer"
                                class={`${string} hover:underline decoration-editor-string/40 underline-offset-4`}
                                >"{content.socials.github}"</a
                            >,
                        </li>
                    </ul>
                </CodeBlock>

                <CodeBlock keyword="var" varTitle="contributions" title="[]Contribution" isStruct={false}>
                    <ul class="list-none flex flex-col gap-1">
                        {content.contributions.map((c) => {
                            return (
                                <li >
                                    <span class="text-editor-text">{'{'}</span>
                                        <ul class="list-none flex flex-col gap-1 pl-4">
                                            <li>
                                                <span class={variable}>Title</span>
                                                <span class="text-editor-text">:</span>
                                                <span class={string}>"<a href={c.url} target="_blank" rel="noopener noreferrer" class="hover:underline decoration-editor-string/40 underline-offset-4">{c.title}</a>"</span>
                                                <span class="text-editor-text">,</span>
                                            </li>
                                            <li>
                                                <span class={variable}>As</span>
                                                <span class="text-editor-text">:</span>
                                                <span class={string}>"{c.type}"</span>
                                                <span class="text-editor-text">,</span>
                                            </li>
                                            <li>
                                                <span class={variable}>Description</span>
                                                <span class="text-editor-text">:</span>
                                                <span class={string}>"{c.description}"</span>
                                                <span class="text-editor-text"></span>
                                            </li>
                                        </ul>
                                    <span class="text-editor-text">{'}'}</span>
                                </li>
                            );
                        })}
                    </ul>
                </CodeBlock>
            </div>
        </aside>

        <!-- Right Content -->
        <section class="flex flex-col gap-10">
            <h2 class="sr-only">Profile</h2>
            <!-- Profile structs -->
            <CodeBlock keyword="type" title="Location" isStruct={true}>
                <div class="flex flex-col gap-1">
                    <div>
                        <span class={variable}>City</span> string
                    </div>
                    <div>
                        <span class={variable}>Country</span> string
                    </div>
                </div>
            </CodeBlock>

            <CodeBlock keyword="type" title="Information" isStruct={true}>
                <div class="flex flex-col gap-1">
                    <div>
                        <span class={variable}>Name</span> string
                    </div>
                    <div>
                        <span class={variable}>Title</span> string
                    </div>
                    <div>
                        <span class={variable}>Email</span> string
                    </div>
                    <div>
                        <span class={variable}>Location</span> Location
                    </div>
                </div>
            </CodeBlock>

            <!-- Profile methods -->
            <div class="flex flex-col gap-4">
                <div class="flex items-center gap-2 whitespace-nowrap">
                    <span class={keyword}>func</span>
                    <span class="text-editor-text">(i *Information)</span>
                    <span class={func}>GetProfile</span>() Information
                </div>
                <div class="text-editor-text">{`{`}</div>
                <div class="pl-6 border-l border-[#333] ml-2 mt-1">
                    <div>
                        <span class={keyword}>return</span> Information{`{`}
                    </div>
                    <div class="pl-6 border-l border-[#444] ml-2 mt-1">
                        <div>
                            <span class={variable}>Name</span>:{" "}
                            <span class={string}>"{content.name}"</span>,
                        </div>
                        <div>
                            <span class={variable}>Title</span>:{" "}
                            <span class={string}>"{content.title}"</span>,
                        </div>
                        <div>
                            <span class={variable}>Email</span>:{" "}
                            <span class={string}>"{content.email}"</span>,
                        </div>
                        <div>
                            <span class={variable}>Location</span>: Location{`{`}
                        </div>
                        <div class="pl-6 border-l border-[#444] ml-2 mt-1">
                            <div>
                                <span class={variable}>City</span>:{" "}
                                <span class={string}>"{content.position.city}"</span>,
                            </div>
                            <div>
                                <span class={variable}>Country</span>:{" "}
                                <span class={string}>
                                    "{content.position.country}"
                                </span>,
                            </div>
                        </div>
                        <div class="text-editor-text">{`},`}</div>
                    </div>
                    <div class="text-editor-text">{`}`}</div>
                </div>
                <div class="text-editor-text">{`}`}</div>
            </div>

            <div class="flex flex-col gap-4">
                <div class="flex items-center gap-2 whitespace-nowrap">
                    <span class={keyword}>func</span>
                    <span class="text-editor-text">(i *Information)</span>
                    <span class={func}>Summary</span>() string
                </div>
                <div class="text-editor-text">{`{`}</div>
                <div class="pl-6 border-l border-[#333] ml-2 mt-1">
                    <div>
                        <span class={keyword}>return</span>{" "}
                        <span class={string}>&#96;</span>
                    </div>
                    <div class={string + " pl-6"}>
                        {content.bio}
                    </div>
                    <div>
                        <span class={string}>&#96;</span>
                    </div>
                </div>
                <div class="text-editor-text">{`}`}</div>
            </div>

            <!-- Experience methods -->
            <div class="flex flex-col gap-4">
                <h2 class="sr-only">Experience</h2>
                <div class="flex items-center gap-2 whitespace-nowrap">
                    <span class={keyword}>func</span>
                    <span class="text-editor-text">(i *Information)</span>
                    <span class={func}>GetExperiences</span>() []Experience
                </div>
                <div class="text-editor-text">{`{`}</div>
                <div class="pl-6 border-l border-[#333] ml-2 mt-1">
                    <div>
                        <span class={variable}>experiences</span> := []Experience{`{`}
                    </div>
                    <div class="pl-6 border-l border-[#444] ml-2 mt-1">
                    {
                        content.experience.map((exp) => (
                            <div class="mb-6 last:mb-0">
                                <div class="text-editor-text">
                                    {`{`}
                                </div>
                                <div class="pl-6 border-l border-[#444] ml-2 mt-1">
                                    <div class="flex flex-col gap-1">
                                        <div>
                                            <span class={variable}>
                                                Company
                                            </span>
                                            :{" "}
                                            {exp.link ? (
                                                <a
                                                    href={exp.link}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class={`hover:underline decoration-editor-string/50 ${string}`}
                                                >
                                                    "{exp.company}"
                                                </a>
                                            ) : (
                                                <span class={string}>
                                                    "{exp.company}"
                                                </span>
                                            )}
                                            ,
                                        </div>
                                        <div>
                                            <span class={variable}>Role</span>:{" "}
                                            <span class={string}>
                                                "{exp.role}"
                                            </span>
                                            ,
                                        </div>
                                        <div>
                                            <span class={variable}>Period</span>
                                            : <span class={func}>Range</span>
                                            {`(`}
                                            <span class={string}>
                                                "{exp.period.from}"
                                            </span>
                                            ,{" "}
                                            <span class={string}>
                                                "{exp.period.to}"
                                            </span>
                                            {`)`},
                                        </div>
                                        <div>
                                            <span class={variable}>
                                                Description
                                            </span>:{" "}
                                            <span class={string}> &#96;</span>
                                        </div>
                                        {exp.bullets.map((b) => (
                                            <div
                                                class={string + " pl-6"}
                                            > * {b}</div>
                                        ))}
                                        <div>
                                            <span class={string}>&#96;</span>,
                                        </div>
                                    </div>
                                </div>
                                <div class="text-editor-text">{`},`}</div>
                            </div>
                        ))
                    }
                    </div>
                    <div class="text-editor-text">{`}`}</div>
                    <div class="mt-6">
                        <span class={keyword}>return</span>{" "}
                        <span class={variable}>experiences</span>
                    </div>
                </div>
                <div class="text-editor-text">{`}`}</div>
            </div>

            <!-- Projects -->
            <div class="flex flex-col gap-4">
                <h2 class="sr-only">Projects</h2>
                <div class="flex items-center gap-2">
                    <span class={keyword}>func</span>
                    <span class="text-editor-text">(i *Information)</span>
                    <span class={func}>GetProjects</span>() []Project
                </div>
                <div class="text-editor-text">{`{`}</div>
                <div class="pl-6 border-l border-[#333] ml-2 mt-1">
                    <div>
                        <span class={variable}>projects</span> := []Project{`{`}
                    </div>
                    <div class="pl-6 border-l border-[#444] ml-2 mt-1">
                    {
                        content.projects.map((proj) => (
                            <div class="mb-6 last:mb-0">
                                <div class="text-editor-text">
                                    {`{`}
                                </div>
                                <div class="pl-6 border-l border-[#444] ml-2 mt-1">
                                    <div class="flex flex-col gap-1">
                                        <div>
                                            <span class={variable}>Name</span>:{" "}
                                            <span class={string}>
                                                "{proj.name}"
                                            </span>
                                            ,
                                        </div>
                                        <div>
                                            <span class={variable}>Stack</span>:
                                            []string{`{`}{" "}
                                            <span class={string}>
                                                "{proj.tech.join('", "')}"
                                            </span>{" "}
                                            {`}`},
                                        </div>
                                        <div>
                                            <span class={variable}>
                                                Description
                                            </span>:{" "}
                                            <span class={string}> &#96;</span>
                                        </div>
                                        <div class={string + " pl-6"}>
                                            {proj.description}
                                        </div>
                                        <div>
                                            <span class={string}>&#96;</span>,
                                        </div>
                                    </div>
                                </div>
                                <div class="text-editor-text">{`},`}</div>
                            </div>
                        ))
                    }
                    </div>
                    <div class="text-editor-text">{`}`}</div>
                    <div class="mt-6">
                        <span class={keyword}>return</span>{" "}
                        <span class={variable}>projects</span>
                    </div>
                </div>
                <div class="text-editor-text">{`}`}</div>
            </div>

            <!-- Articles -->
            <div class="flex flex-col gap-4">
                <h2 class="sr-only">Articles</h2>
                <div class="flex items-center gap-2">
                    <span class={keyword}>func</span>
                    <span class="text-editor-text">(i *Information)</span>
                    <span class={func}>LatestArticles</span>() []Article
                </div>
                <div class="text-editor-text">{`{`}</div>
                <div class="pl-6 border-l border-[#333] ml-2 mt-1">
                    <div>
                        <span class={variable}>articles</span> := []Article{`{`}
                    </div>
                    <div class="pl-6 border-l border-[#444] ml-2 mt-1">
                    {
                        articles.map((art) => (
                            <div class="mb-6 last:mb-0">
                                <div class="text-editor-text">
                                    {`{`}
                                </div>
                                <div class="pl-6 border-l border-[#444] ml-2 mt-1">
                                    <div class="flex flex-col gap-1">
                                        <div>
                                            <span class={variable}>Title</span>:{" "}
                                            <span class={string}>
                                                "{art.title}"
                                            </span>,
                                        </div>
                                        <div>
                                            <span class={variable}>URL</span>:{" "}
                                            <a
                                                href={art.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class={string + " hover:underline decoration-editor-string/40 underline-offset-4"}
                                            >
                                                "{art.url}"
                                            </a>,
                                        </div>
                                        {art.description && (
                                            <div>
                                                <span class={variable}>
                                                    Description
                                                </span>:{" "}
                                                <span class={string}>
                                                    "{art.description}"
                                                </span>,
                                            </div>
                                        )}
                                    </div>
                                </div>
                                <div class="text-editor-text">{`},`}</div>
                            </div>
                        ))
                    }
                    </div>
                    <div class="text-editor-text">{`}`}</div>
                    <div class="mt-6">
                        <span class={keyword}>return</span>{" "}
                        <span class={variable}>articles</span>
                    </div>
                </div>
                <div class="text-editor-text">{`}`}</div>
            </div>

            <section aria-labelledby="contact-heading">
                <h2 id="contact-heading" class="sr-only">Contact</h2>
                <ContactForm />
            </section>
        </section>
    </main>
</Layout>

<style>
    .code-container {
        @apply font-mono leading-relaxed;
    }

    @media (max-width: 1279px) {
        :global(body) {
            overflow-x: hidden;
        }

        .portfolio-canvas {
            transform: scale(calc(100vw / 1280px));
            transform-origin: top left;
            margin-left: 0;
            margin-right: 0;
        }
    }
</style>
